---
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../data/products.ts';
import { SITE, breadcrumb } from '../data/site.ts';

/** Product information and development concepts, rendered from shared data. */

const title = 'Products & Concepts — Fasolati Oral, Gut & Life Board';
const description =
  'Explore Loria product information and the Lytica, Gut Stack and Life Board development directions. Ask a product question or request development updates.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE}/shop/`,
    url: `${SITE}/shop/`,
    name: title,
    description,
    isPartOf: { '@id': `${SITE}/#website` },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE}/shop/#products`,
    name: 'Fasolati products and development concepts',
    itemListElement: PRODUCTS.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${SITE}/${p.slug}/`,
    })),
  },
  breadcrumb('Products & Concepts', '/shop/'),
];
---
<Base title={title} description={description} path="/shop/" schema={schema}>
  <div class="shop-inner">
    <div class="shop-hero">
      <h1>Products & Concepts</h1>
      <p>Explore Loria product information and Fasolati’s development directions. Ask about current product details or request updates on the work ahead. These pages are inquiry paths, not checkout or enrollment.</p>
    </div>

    {PRODUCTS.map((p) => (
      <article class={`shop-product${p.stage === 'information' ? ' featured' : ''}`}>
        <span class="sp-badge" style={`color:${p.accent};border-color:${p.accent}`}>
          {p.status}
        </span>
        <h2 class="sp-name" style={`color:${p.accent}`}>{p.name}</h2>
        <p class="sp-tagline">{p.tagline}</p>
        <p class="sp-body">{p.body}</p>

        {p.specs && (
          <div class="sp-details">
            {p.specs.map((s) => (
              <div class="sp-detail">
                <h3 style={`color:${p.accent}`}>{s.label}</h3>
                <p>{s.value}</p>
              </div>
            ))}
          </div>
        )}

        <div class="sp-cta">
          <a class="btn bp" href={`/${p.slug}/`}>
            {`Explore ${p.shortName} →`}
          </a>
        </div>
      </article>
    ))}
  </div>

  <nav class="page-next" aria-label="Related pages">
    <a href="/platform/"><h3>The Platform</h3><p>How the product and research directions fit together.</p></a>
    <a href="/science/"><h3>Science Spine</h3><p>Evidence and the proposed validation work.</p></a>
    <a href="/about/"><h3>About Fasolati</h3><p>The founder and the purpose.</p></a>
  </nav>
</Base>
