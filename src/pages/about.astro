---
import Base from '../layouts/Base.astro';
import { SITE, breadcrumb } from '../data/site.ts';

const title = 'About Fasolati — Oral Health, Better Questions, Clearer Decisions';
const description =
  'Meet the purpose behind Fasolati: an oral, gut and systemic research direction founded by Thad Connelly, oral and maxillofacial surgeon and Gengyve founder.';

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE}/about/`,
    url: `${SITE}/about/`,
    name: title,
    description,
    isPartOf: { '@id': `${SITE}/#website` },
    about: { '@id': `${SITE}/#organization` },
    mainEntity: { '@id': `${SITE}/#founder` },
  },
  breadcrumb('About', '/about/'),
];
---
<Base title={title} description={description} path="/about/" schema={schema}>
  <div class="about-inner">
    <div class="about-hero">
      <h1>Better Questions.<br />Clearer Decisions.</h1>
      <p>Fasolati’s ambition is to make oral, gut and systemic research useful—without turning a promising mechanism into a personal health claim before the evidence is there.</p>
    </div>

    <div class="ab-section" id="origin">
      <div class="ab-section-num" style="color:var(--t)">The Founder</div>
      <h2>Thad Connelly</h2>
      <p class="ab-body">Thad Connelly is an oral and maxillofacial surgeon and the founder of Gengyve. Fasolati brings an oral-health starting point to a broader research and product-development direction.</p>
      <p class="ab-body">The central question: can better measurement of oral bacterial activity add useful information beyond routine examination and existing measures—and help justify a better next step?</p>
    </div>

    <div class="ab-section" id="mission">
      <div class="ab-section-num" style="color:var(--g)">The Mission</div>
      <h2>Make the Next Step More Informed</h2>
      <p class="ab-body">We want fewer demands on the person and more discipline in the engine. Oral, gut and systemic observations belong in a connected research program, but they should keep their own meaning rather than disappear into one averaged score.</p>
      <div class="ab-values">
        <div class="ab-val"><h4 style="color:var(--t)">Evidence Before Inference</h4><p>Our standard is to distinguish a measured result, a validated association, an experimental mechanism and an untested hypothesis.</p></div>
        <div class="ab-val"><h4 style="color:var(--g)">Uncertainty in View</h4><p>The proposed Life Board should answer what changed, how confident we are and what next step is justified—including when a result is not interpretable yet.</p></div>
        <div class="ab-val"><h4 style="color:var(--t)">Clinical Judgment Matters</h4><p>Development concepts are not instructions for care. The intended role is to support informed discussion, not automate prescribing or replace dental and medical evaluation.</p></div>
        <div class="ab-val"><h4 style="color:var(--g)">Outcomes Over a Story</h4><p>We aim to test defined interventions against meaningful outcomes, retain unfavorable results and change the model when the evidence calls for it.</p></div>
      </div>
    </div>

    <div class="ab-section" id="milestones">
      <div class="ab-section-num" style="color:var(--t)">The Work Ahead</div>
      <h2>Build What the Evidence Can Support</h2>
      <p class="ab-body">The research priorities are to define the analyte, establish repeatable measurement, test whether it adds information beyond simpler measures, and evaluate the finished intervention. These are development gates, not completed milestones.</p>
      <p class="ab-body">Loria has a product-information inquiry path. Lytica, the Gut Stack and the Life Board have distinct development questions. A shared brand does not give them a shared efficacy claim.</p>
    </div>

    <div style="text-align:center;margin-top:40px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a class="btn bp" href="/partner/">Partner With Us</a>
      <a href="/science/" class="btn bs">Read the Science Spine</a>
    </div>
  </div>

  <nav class="page-next" aria-label="Related pages">
    <a href="/platform/"><h3>The Platform</h3><p>Product information and development directions.</p></a>
    <a href="/science/"><h3>Science Spine</h3><p>Evidence, limitations and the proposed research plan.</p></a>
    <a href="/partner/"><h3>Partner With Us</h3><p>Clinical, research, business and product inquiries.</p></a>
  </nav>
</Base>
