---
import Base from '../layouts/Base.astro';

/**
 * The contact form.
 *
 * `noindex` and excluded from the sitemap (see astro.config.mjs): a form has
 * no standalone search intent, and indexing it competes with the pages that
 * should rank for "fasolati partner" / "fasolati clinicians". It stays
 * `follow` so links out of it still pass through.
 */

const title = 'Contact Fasolati — Product, Research & Partnership Inquiries';
const description =
  'Ask about Loria product information, discuss research or clinical collaboration, or explore Fasolati’s development and business direction. General inquiries welcome.';
---
<Base title={title} description={description} path="/partner/" noindex={true}>
  <div class="partner-inner">


    <div class="partner-hero">
      <h1>Connect With Fasolati</h1>
      <p>Ask about Loria, discuss a research question or explore a potential collaboration. Clinicians, researchers, business partners, investors and general inquiries are welcome.</p>
    </div>

    <!-- FORM -->
    <form class="partner-form" id="partner-form">

      <!-- Step 1: Role Selection -->
      <div style="margin-bottom:12px"><span class="pf-label">I'm interested as a<span class="req">*</span></span></div>
      <div class="role-grid" id="role-grid" role="group" aria-label="Inquiry role">
        <button type="button" class="role-card" data-role="clinician">
          <span class="role-icon" style="display:block" aria-hidden="true">+</span>
          <span class="role-name" style="display:block">Clinician</span>
          <span class="role-desc" style="display:block">Discuss clinical questions and development</span>
        </button>
        <button type="button" class="role-card" data-role="investor">
          <span class="role-icon" style="display:block" aria-hidden="true">◆</span>
          <span class="role-name" style="display:block">Investor</span>
          <span class="role-desc" style="display:block">Explore the business and research direction</span>
        </button>
        <button type="button" class="role-card" data-role="dso">
          <span class="role-icon" style="display:block" aria-hidden="true">⬡</span>
          <span class="role-name" style="display:block">DSO Partner</span>
          <span class="role-desc" style="display:block">Discuss practice-network needs</span>
        </button>
        <button type="button" class="role-card" data-role="researcher">
          <span class="role-icon" style="display:block" aria-hidden="true">⊛</span>
          <span class="role-name" style="display:block">Researcher</span>
          <span class="role-desc" style="display:block">Explore a potential research collaboration</span>
        </button>
        <button type="button" class="role-card" data-role="general" style="grid-column:1/-1">
          <span class="role-icon" style="display:block" aria-hidden="true">→</span>
          <span class="role-name" style="display:block">Product / General Interest</span>
          <span class="role-desc" style="display:block">Ask about Loria or a Fasolati development</span>
        </button>
      </div>

      <!-- Role-specific value props -->
      <div class="role-value" id="rv-clinician"><h4>For Clinicians</h4><p>Discuss intended uses, product-information needs and the evidence required for future evaluation. This inquiry does not enroll your practice in a live pilot or authorize a treatment protocol.</p></div>
      <div class="role-value" id="rv-investor" style="border-left-color:var(--g)"><h4>For Investors</h4><p>Discuss the oral, gut and systemic development direction, its assumptions and the milestones needed to test them. Commercial ambition and demonstrated clinical utility are separate questions.</p></div>
      <div class="role-value" id="rv-dso" style="border-left-color:var(--t)"><h4>For DSO Partners</h4><p>Share practice-network needs and explore potential collaboration. Product availability, implementation, evidence and any commercial terms would need a separate discussion.</p></div>
      <div class="role-value" id="rv-researcher" style="border-left-color:var(--g)"><h4>For Researchers</h4><p>Discuss analyte definition, assay validation, source attribution or study design. Any future data or specimen collaboration would need appropriate consent, governance and review; this form does not grant data access.</p></div>
      <div class="role-value" id="rv-general"><h4>Product & General Questions</h4><p>Ask about Loria’s current labeling, formulation or purchasing information, or request information about a development concept. Please keep your message to a general inquiry—not personal health advice or medical records.</p></div>

      <!-- Contact Fields -->
      <div class="pf-row">
        <div class="pf-group"><label class="pf-label" for="pf-first">First Name<span class="req">*</span></label><input class="pf-input" type="text" id="pf-first" placeholder="First name" autocomplete="given-name" required></div>
        <div class="pf-group"><label class="pf-label" for="pf-last">Last Name<span class="req">*</span></label><input class="pf-input" type="text" id="pf-last" placeholder="Last name" autocomplete="family-name" required></div>
      </div>
      <div class="pf-group"><label class="pf-label" for="pf-email">Email<span class="req">*</span></label><input class="pf-input" type="email" id="pf-email" placeholder="you@example.com" autocomplete="email" required></div>
      <div class="pf-row">
        <div class="pf-group"><label class="pf-label" for="pf-phone">Phone (optional)</label><input class="pf-input" type="tel" id="pf-phone" placeholder="Phone number" autocomplete="tel"></div>
        <div class="pf-group"><label class="pf-label" for="pf-company">Company / Practice (optional)</label><input class="pf-input" type="text" id="pf-company" placeholder="Organization name" autocomplete="organization"></div>
      </div>
      <div class="pf-group"><label class="pf-label" for="pf-message">Message (optional)</label><textarea class="pf-textarea" id="pf-message" aria-describedby="partner-privacy" placeholder="Your product, research or business question. Do not include medical records, lab results or other sensitive health information."></textarea></div>

      <button type="submit" class="pf-submit" id="pf-submit" disabled>Select a role above to continue</button>
      <p class="form-status" id="partner-status" role="status" aria-live="polite"></p>
      <p class="pf-note" id="partner-privacy">Submitting asks Fasolati to respond to your inquiry. Your contact details, selected role and message are sent through HubSpot. Delivery is confirmed only after the service accepts the request; if an error occurs, your entries remain here so you can retry. Do not submit health records, lab results or sensitive personal information. This is not a clinical or emergency contact channel.</p>
      <noscript><p class="pf-note">This form requires JavaScript to send an inquiry. Enable JavaScript to use it.</p></noscript>
    </form>

    <!-- Success State -->
    <div class="partner-success" id="partner-success" role="status" aria-live="polite">
      <div class="ps-icon" aria-hidden="true">✓</div>
      <div class="ps-title">Thank You for Reaching Out</div>
      <p class="ps-body">Your inquiry was accepted by our contact service. While you wait for a reply, explore the platform and research direction:</p>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:28px;flex-wrap:wrap">
        <a href="/science/" class="btn bp">Read the Science Spine</a>
        <a href="/platform/" class="btn bs">Explore the Platform</a>
      </div>
    </div>

  
  </div>

  <script src="../scripts/partner-form.js"></script>
</Base>
