---
import Nav from '../components/Nav.astro';
import { SITE, DEFAULTS, BASE_GRAPH } from '../data/site.ts';
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/science.css';
import '../styles/quality.css';

interface Props {
  title: string;
  description: string;
  /** Site-root-relative, with a trailing slash — "/loria/". */
  path: string;
  /** Extra schema.org nodes merged into the shared @graph. */
  schema?: Record<string, unknown>[];
  /** The home page keeps its own hero; interior pages get top padding. */
  interior?: boolean;
  /** Pages with no standalone search intent — the contact form, 404. */
  noindex?: boolean;
}

const { title, description, path, schema = [], interior = true, noindex = false } = Astro.props;

/**
 * Canonical, og:url and the sitemap all derive from `site` in
 * astro.config.mjs and the page's own `path`. The hand-written page pointed
 * every one of these at a domain that does not resolve and that the portfolio
 * does not own, so the whole site consolidated its ranking signals onto
 * nothing. Deriving them from one constant is what stops that recurring — and
 * the deploy workflow greps the built output for that domain, so a
 * reintroduction fails the build rather than shipping.
 *
 * This note lives in the frontmatter rather than in an HTML comment: comments
 * in the template are served to every visitor and crawler, and one naming the
 * wrong domain would trip the very check it describes.
 */
const canonical = `${SITE}${path}`;
const graph = [...BASE_GRAPH, ...schema];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<title>{title}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonical} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Fasolati" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={DEFAULTS.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Fasolati. Oral health, in the whole picture. Evidence-led research and development." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={DEFAULTS.ogImage} />
<meta name="author" content={DEFAULTS.author} />
<meta
  name="robots"
  content={noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Fasolati evidence updates" href="/evidence-updates.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>
  document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
</script>
<noscript><style>.mo{opacity:1!important;transform:none!important}.hamburger,.theme-toggle{display:none!important}.no-js-nav{display:flex;gap:16px;flex-wrap:wrap;padding:100px 24px 12px;position:relative;z-index:2}.no-js-nav a{color:var(--t)}</style></noscript>

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

</head>
<body>

<a href="#main-content" class="skip-link">Skip to content</a>
<canvas id="particle-canvas" aria-hidden="true"></canvas>

<Nav />
<noscript><nav class="no-js-nav" aria-label="Site navigation"><a href="/">Home</a><a href="/science/">Science</a><a href="/life-board/">Life Board</a><a href="/pathway/">Pathway</a><a href="/evidence/">Evidence ledger</a><a href="/loria-dossier/">Loria dossier</a><a href="/design-partners/">Design partners</a><a href="/platform/">Programs</a><a href="/shop/">Products</a><a href="/about/">About</a><a href="/partner/">Contact</a></nav></noscript>

<main id="main-content" class={interior ? 'page' : undefined} tabindex="-1">
  <slot />
</main>

<footer>
  <p><span style="color:var(--t)">Fasolati</span> · Oral · Gut · Systemic</p>
  <p>Research and product development. This website does not provide individualized diagnosis or treatment.</p>
  <p><a href="/science/">Science spine</a> · <a href="/evidence/">Evidence ledger</a> · <a href="/design-partners/">Design partners</a> · <a href="/partner/">Contact</a> · <a href="/privacy/">Website data & privacy</a></p>
</footer>

<script src="../scripts/site.js"></script>
</body>
</html>
