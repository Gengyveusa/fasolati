+# Use RABBITMQ_URL as broker, but fall back to REDIS_URL if RABBITMQ_URL
+# points at Redis (Railway has no RabbitMQ plugin).
+_broker = settings.RABBITMQ_URL
+if _broker.startswith("redis://") or _broker.startswith("rediss://"):
+    _broker = _broker  # already Redis — use as-is
