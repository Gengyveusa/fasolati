--- /dev/null
+++ b/railway.toml
@@ -0,0 +1,56 @@
+# ============================================================
+# FortressFlow — Railway Deployment Configuration
+#
+# This project deploys as 3 services on Railway:
+#   1. backend  — FastAPI + Alembic migrations
+#   2. frontend — Next.js 15 standalone
+#   3. worker   — Celery async task processor
+#
+# Required Railway plugins: PostgreSQL, Redis
+# RabbitMQ is NOT available — Celery uses Redis as broker.
+#
+# Setup:
+#   1. Create a new project on Railway
+#   2. Add PostgreSQL and Redis plugins
+#   3. Create 3 services pointing at this repo
+#   4. Set root directory + start command per service (see below)
+#   5. Set environment variables (see .env.example)
+#
+# Backend service:
+#   Root directory: backend
+#   Build command: (uses Dockerfile)
+#   Start command: bash start.sh
+#   Variables:
+#     DATABASE_URL=${{Postgres.DATABASE_URL}}
+#     REDIS_URL=${{Redis.REDIS_URL}}
+#     RABBITMQ_URL=${{Redis.REDIS_URL}}  ← use Redis as Celery broker
+#     SECRET_KEY=<openssl rand -hex 32>
+#     UNSUBSCRIBE_HMAC_KEY=<openssl rand -hex 16>
+#     ENVIRONMENT=production
+#     CORS_ORIGINS=https://<frontend-domain>
+#     PORT=8000
+#
+# Frontend service:
+#   Root directory: frontend
+#   Build command: (uses Dockerfile)
+#   Variables:
+#     BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000
+#     NEXT_PUBLIC_BACKEND_URL=https://<backend-public-domain>
+#     NEXTAUTH_URL=https://<frontend-public-domain>
+#     NEXTAUTH_SECRET=<openssl rand -hex 32>
+#
+# Worker service:
+#   Root directory: backend
+#   Build command: (uses Dockerfile)
+#   Start command: celery -A app.workers.celery_app worker --loglevel=info --concurrency=2
+#   Variables: (same as backend)
+# ============================================================
+
+[build]
+builder = "DOCKERFILE"
+
+[deploy]
+healthcheckPath = "/health"
+healthcheckTimeout = 300
+restartPolicyType = "ON_FAILURE"
+restartPolicyMaxRetries = 5
-- 
