diff --git a/frontend/src/lib/backend-proxy.ts b/frontend/src/lib/backend-proxy.ts
new file mode 100644
index 0000000..4e9e692
--- /dev/null
+++ b/frontend/src/lib/backend-proxy.ts
@@ -0,0 +1,153 @@
+/**
+ * Backend proxy utility for Next.js API routes.
+ *
+ * Forwards requests from the Next.js frontend API routes to the
+ * real FastAPI backend, preserving method, headers, query params,
+ * and body. Handles both JSON and streaming (SSE) responses.
+ */
+
+import { NextRequest, NextResponse } from "next/server";
+
+const BACKEND_URL =
+  process.env.BACKEND_URL ||
+  process.env.NEXT_PUBLIC_BACKEND_URL ||
+  "http://localhost:8000";
+
+interface ProxyOptions {
+  /** Override the backend path (default: derived from the request URL) */
+  path?: string;
+  /** Extra headers to add to the backend request */
+  extraHeaders?: Record<string, string>;
+  /** If true, return the raw Response for streaming (SSE) */
+  stream?: boolean;
+}
+
+/**
+ * Proxy a Next.js API route request to the FastAPI backend.
+ *
+ * Usage in a route handler:
+ *   export async function GET(req: NextRequest, ctx?: { params: Promise<Record<string, string>> }) {
+ *     return proxyToBackend(req, ctx);
+ *   }
+ */
+export async function proxyToBackend(
+  req: NextRequest,
+  ctx?: { params?: Promise<Record<string, string>> },
+  options?: ProxyOptions
+): Promise<NextResponse | Response> {
+  // Resolve dynamic route params if present
+  const resolvedParams = ctx?.params ? await ctx.params : {};
+
+  // Build backend URL path
+  let backendPath: string;
+  if (options?.path) {
+    backendPath = options.path;
+  } else {
+    // Extract path after /api/v1 and substitute dynamic params
+    const url = new URL(req.url);
+    backendPath = url.pathname.replace(/^\/api\/v1/, "/api/v1");
+
+    // Replace Next.js [param] segments with actual values
+    for (const [key, value] of Object.entries(resolvedParams)) {
+      // The path already has the resolved value from Next.js routing,
+      // so we don't need to substitute — the URL already contains it.
+      void key;
+      void value;
+    }
+
+    // Preserve query string
+    if (url.search) {
+      backendPath += url.search;
+    }
+  }
+
+  const targetUrl = `${BACKEND_URL}${backendPath}`;
+
+  // Forward headers, stripping hop-by-hop headers
+  const headers = new Headers();
+  const skipHeaders = new Set([
+    "host",
+    "connection",
+    "keep-alive",
+    "transfer-encoding",
+    "te",
+    "trailer",
+    "upgrade",
+    "proxy-authorization",
+    "proxy-authenticate",
+  ]);
+
+  req.headers.forEach((value, key) => {
+    if (!skipHeaders.has(key.toLowerCase())) {
+      headers.set(key, value);
+    }
+  });
+
+  // Add any extra headers
+  if (options?.extraHeaders) {
+    for (const [key, value] of Object.entries(options.extraHeaders)) {
+      headers.set(key, value);
+    }
+  }
+
+  // Build fetch options
+  const fetchOptions: RequestInit = {
+    method: req.method,
+    headers,
+  };
+
+  // Forward body for non-GET/HEAD requests
+  if (req.method !== "GET" && req.method !== "HEAD") {
+    const contentType = req.headers.get("content-type") || "";
+
+    if (contentType.includes("multipart/form-data")) {
+      // For file uploads, pass the raw body and let fetch set the boundary
+      fetchOptions.body = await req.arrayBuffer();
+      // Keep the original content-type with boundary
+    } else if (contentType.includes("application/json")) {
+      fetchOptions.body = await req.text();
+    } else {
+      // Pass through raw body for other content types
+      fetchOptions.body = await req.arrayBuffer();
+    }
+  }
+
+  try {
+    const backendResponse = await fetch(targetUrl, fetchOptions);
+
+    // For streaming responses (SSE), pass through directly
+    if (options?.stream || backendResponse.headers.get("content-type")?.includes("text/event-stream")) {
+      return new Response(backendResponse.body, {
+        status: backendResponse.status,
+        headers: {
+          "Content-Type": backendResponse.headers.get("content-type") || "text/event-stream",
+          "Cache-Control": "no-cache",
+          "Connection": "keep-alive",
+        },
+      });
+    }
+
+    // For regular JSON responses
+    const responseHeaders = new Headers();
+    backendResponse.headers.forEach((value, key) => {
+      if (!skipHeaders.has(key.toLowerCase())) {
+        responseHeaders.set(key, value);
+      }
+    });
+
+    const body = await backendResponse.arrayBuffer();
+    return new NextResponse(body, {
+      status: backendResponse.status,
+      headers: responseHeaders,
+    });
+  } catch (error) {
+    console.error(`[proxy] Failed to reach backend at ${targetUrl}:`, error);
+    return NextResponse.json(
+      {
+        detail: "Backend service unavailable",
+        error: error instanceof Error ? error.message : "Unknown error",
+      },
+      { status: 502 }
+    );
+  }
+}
